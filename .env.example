# Copy to .env before `docker compose up` when you want AI extraction.
# The compose file reads these names for interpolation. Do not commit .env.

OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_CHUNK_CHARS=12000

# Web origins that may call the API (comma separated; no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_SESSION_HOURS=8

# Public URLs are https://www.zhengaihe.top/crawler/<hashid>.
# Proxy /crawler/<32 hexadecimal characters> to the API, preserving the path.
# Empty uses local API /p/<hashid> links for development.
PUBLIC_BASE_URL=https://www.zhengaihe.top/crawler

# Optional overrides. Defaults inside compose point at the db/redis services.
# DATABASE_URL=postgresql://user:pass@db:5432/crawler_db
# REDIS_URL=redis://redis:6379/0
# CRAWLER_USER_AGENT=CrawlerPlatformBot/1.0 (+https://github.com/machachong/crawler-platform; respects robots.txt)
